# ── BUTCHER PROTOCOL — environment ────────────────────────────────────────────
# Never commit a real key. `.env` is git-ignored; only `.env.example` is tracked.
#
# GEMINI_API_KEY is a SERVER variable. It must never be exposed to the browser
# and must never use a client-exposed prefix (VITE_*, NEXT_PUBLIC_*, etc.).
# The Vite build below will not forward this value to client code.

GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-31b-it

# ── Phase 02 ──────────────────────────────────────────────────────────────────
# Supabase / job API / viaSocket credentials arrive in Phase 02. Left blank.
# Note: the Vite build only exposes variables prefixed `BP_PUBLIC_`, so nothing
# above can ever be read by client code.
SUPABASE_URL=
SUPABASE_ANON_KEY=
VIEWSOCKET_API_KEY=